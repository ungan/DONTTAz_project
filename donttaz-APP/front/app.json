{
  "expo": {
    "name": "DONTTAz",
    "slug": "DONTTAz",
    "owner": "cnchoo25",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "front",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hoein.front",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
