{
  "expo": {
    "name": "DONTTAz",
    "slug": "DONTTAz",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "front",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./shared/assets/mascots/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hoein.front",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hoein.front",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a895a1b4-a282-466e-a78c-870a452993ce"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a895a1b4-a282-466e-a78c-870a452993ce"
    },
    "owner": "ratatouille104"
  }
}
